DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=studyapp
POSTGRES_USER=studyapp
POSTGRES_PASSWORD=studyapp
DATABASE_URL=postgres://studyapp:studyapp@db:5432/studyapp

# Optional: enables LLM-powered structuring. Leave blank to use the
# built-in heuristic engine (no external calls needed).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
